    "main": "src/index.mjs",
    "license": "MIT",
    "author": "FlowMCP",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/FlowMCP/gtfs-sqlite-toolkit.git"
    },
    "bugs": {
        "url": "https://github.com/FlowMCP/gtfs-sqlite-toolkit/issues"
    },
    "homepage": "https://github.com/FlowMCP/gtfs-sqlite-toolkit#readme",
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --passWithNoTests",
        "test:coverage:src": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --passWithNoTests",
        "test:manual": "node tests/manual/run-all.mjs"
    },
    "dependencies": {
        "tar": "^7.4.3",
        "yauzl": "^3.2.0"
    },
    "peerDependencies": {
        "better-sqlite3": "^11.10.0 || ^12.0.0"
    },
    "devDependencies": {
        "@types/node": "^22.10.0",
        "better-sqlite3": "^11.10.0",
        "jest": "^30.0.0",
        "yazl": "^3.3.1"
    }
}
